# ─────────────────────────────────────────────────────────────────────────────
# AI Radar — environment configuration
# Copy to .env and edit. Only the REQUIRED section is needed to run the app.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Docker Compose sets this for you; for a local
# Postgres use something like postgres://localhost:5432/ai_radar
DATABASE_URL=postgres://ai_radar:ai_radar@localhost:5432/ai_radar

# Public URL of the web app (used in emails, push deep links, manifest).
APP_URL=http://localhost:3000

# ── WORKER ──────────────────────────────────────────────────────────────────
# How often the worker ingests all sources, in minutes.
# 180 matches the cron in .github/workflows/ingest.yml, and it is what the
# catalogue warrants rather than a round number: about 30 new items a day
# across every feed, so a half-hourly pass fetched well under one new item and
# re-requested 25 other people's servers to find that out.
INGEST_INTERVAL_MINUTES=180
# Secret that protects the /api/internal/* endpoints (ingest trigger, cron).
# Generate with: openssl rand -hex 32
# The worker refuses to start while this is "change-me" or empty.
INTERNAL_API_SECRET=change-me

# ── OPTIONAL: AI summaries ──────────────────────────────────────────────────
# Without a provider the app still works: ranking is deterministic and cards
# show source excerpts instead of AI summaries.
# One of: none | ollama | anthropic | openai-compatible
LLM_PROVIDER=none

# THE CHEAPEST THING THAT WORKS, and the difference is real money at nobody's
# profit: one summary is about 300 input and 250 output tokens (measured over
# 60 stories from a live database), so 20 a day for 30 days is ~$1.30 on
# Claude Haiku and ~$0.20 on DeepSeek. Both are inside any sane budget; the
# cheap one is free to pick. Full arithmetic in docs/cost-protection.md.
#
# All three below speak the same protocol, so switching provider is these
# three lines and no code.

# DeepSeek (https://platform.deepseek.com) — cheapest metered option.
# OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
# OPENAI_COMPATIBLE_API_KEY=
# LLM_MODEL=deepseek-flash

# Google Gemini (https://aistudio.google.com/apikey) — has a free tier, which
# is a QUOTA rather than a promise: it is per project, it resets daily, and
# free-tier input may be used to improve Google's products. Read the terms
# before pointing a public instance at it.
# OPENAI_COMPATIBLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_COMPATIBLE_API_KEY=
# LLM_MODEL=gemini-2.5-flash-lite

# Groq (https://console.groq.com) — free developer rate limits, same caveat.
# OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPATIBLE_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# Anthropic (https://console.anthropic.com). Haiku keeps monthly cost near $1.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-4-5

# Local Ollama (https://ollama.com)
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2

# Cost guardrails: never summarize more than this many stories per day.
# This is the ONLY thing that decides the bill. Readers do not multiply it:
# a summary is written once per story and every reader is served the same row,
# so one reader and a hundred readers cost exactly the same.
LLM_MAX_STORIES_PER_DAY=20

# ── OPTIONAL: X / Twitter (milestone 3) ─────────────────────────────────────
# X_PROVIDER=none            # none | official | rsshub
# X_BEARER_TOKEN=
# RSSHUB_BASE_URL=https://rsshub.app

# ── OPTIONAL: Web Push — the brief that arrives on its own ──────────────────
# Without these three the app runs exactly as before and Settings says, in
# plain words, that this copy cannot send to anyone. Nothing here is a paid
# service: a VAPID key pair is generated locally and the browsers' push
# services are free.
#
# Generate the pair with: npx web-push generate-vapid-keys
# The subject must be a mailto: or https: URL identifying whoever runs this
# instance — push services use it to contact you about misbehaving senders.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ── OPTIONAL: Email digest via SMTP (milestone 3) ───────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="AI Radar <brief@example.com>"
