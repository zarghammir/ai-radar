# ─────────────────────────────────────────────────────────────────────────────
# AI Radar — environment configuration
# Copy to .env and edit. Only the REQUIRED section is needed to run the app.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Docker Compose sets this for you; for a local
# Postgres use something like postgres://localhost:5432/ai_radar
DATABASE_URL=postgres://ai_radar:ai_radar@localhost:5432/ai_radar

# Public URL of the web app (used in emails, push deep links, manifest).
APP_URL=http://localhost:3000

# ── WORKER ──────────────────────────────────────────────────────────────────
# How often the worker ingests all sources, in minutes.
INGEST_INTERVAL_MINUTES=30
# Secret that protects the /api/internal/* endpoints (ingest trigger, cron).
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=change-me

# ── OPTIONAL: AI summaries ──────────────────────────────────────────────────
# Without a provider the app still works: ranking is deterministic and cards
# show source excerpts instead of AI summaries.
# One of: none | ollama | anthropic | openai-compatible
LLM_PROVIDER=none

# Anthropic (https://console.anthropic.com). Haiku keeps monthly cost near $1.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-4-5

# OpenAI-compatible endpoint (OpenAI, Groq, Gemini, OpenRouter, LM Studio …)
# OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPATIBLE_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# Local Ollama (https://ollama.com)
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2

# Cost guardrails: never summarize more than this many stories per day.
LLM_MAX_STORIES_PER_DAY=20

# ── OPTIONAL: X / Twitter (milestone 3) ─────────────────────────────────────
# X_PROVIDER=none            # none | official | rsshub
# X_BEARER_TOKEN=
# RSSHUB_BASE_URL=https://rsshub.app

# ── OPTIONAL: Web Push (milestone 3) ────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ── OPTIONAL: Email digest via SMTP (milestone 3) ───────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="AI Radar <brief@example.com>"
